  },
  "optionalDependencies": {
    "@1agents/core-linux-x64": "0.0.0-dev",
    "@1agents/core-linux-arm64": "0.0.0-dev",
    "@1agents/core-darwin-arm64": "0.0.0-dev",
    "@1agents/happy": "0.0.0-dev"
  },
